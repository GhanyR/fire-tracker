{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "report.schema.json",
 "title": "Laporan lapangan (reports.json, POST /report, inputs/*.csv)",
 "type": "object",
 "required": [
  "lat",
  "lon"
 ],
 "properties": {
  "lat": {
   "type": "number"
  },
  "lon": {
   "type": "number"
  },
  "time": {
   "type": "string"
  },
  "status": {
   "type": "string",
   "examples": [
    "Api menyala",
    "Bara / api di bawah permukaan (gambut)",
    "Sudah dipadamkan",
    "Tidak ditemukan api (titik panas palsu)"
   ]
  },
  "team": {
   "type": "string"
  },
  "note": {
   "type": "string",
   "maxLength": 500
  },
  "photo": {
   "type": "string"
  },
  "area": {
   "type": [
    "string",
    "number"
   ],
   "description": "Perkiraan luas (ha)"
  },
  "kind": {
   "type": "string"
  },
  "source": {
   "type": "string"
  },
  "url": {
   "type": "string"
  }
 }
}